# Copy to .env and adjust.
DATABASE_URL="file:./dev.db"

# Where uploaded coach employment-proof files are stored (kept out of git).
STORAGE_DIR="./storage"

# Price of one 3-coach evaluation, in cents. Shown on the site; keep it equal
# to the price set on the Stripe Payment Link.
EVALUATION_PRICE_CENTS=29900

# Hours a coach may hold a claimed evaluation before it is released back to the queue.
CLAIM_HOURS=72

# Used by `npm run db:seed` to create the first admin account.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"

# Stripe Payment Link players are sent to. Leave empty to use the built-in
# test checkout (no card charged).
STRIPE_PAYMENT_LINK_URL="https://buy.stripe.com/test_5kQ6oI86T8bI5d61S4cbC01"

# Signing secret (whsec_...) of the webhook endpoint pointing at
# /api/stripe/webhook. Required for Stripe payments to be recorded.
STRIPE_WEBHOOK_SECRET=""

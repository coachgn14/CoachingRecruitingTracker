# Copy to .env and adjust.
DATABASE_URL="file:./dev.db"

# Where uploaded coach employment-proof files are stored (kept out of git).
STORAGE_DIR="./storage"

# Price of one 3-coach evaluation, in cents.
EVALUATION_PRICE_CENTS=14900

# Hours a coach may hold a claimed evaluation before it is released back to the queue.
CLAIM_HOURS=72

# Used by `npm run db:seed` to create the first admin account.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
PAYMENTS_MODE="test"
